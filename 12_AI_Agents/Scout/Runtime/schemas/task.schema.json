{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buxa.ai/scout/runtime/schemas/task.schema.json",
  "title": "Scout Runtime Task",
  "description": "Defines the structured business request accepted by Scout Runtime. A Task is the root object of a Runtime execution lifecycle.",
  "type": "object",
  "additionalProperties": false,

  "$defs": {
    "task_status": {
      "title": "Task Status",
      "description": "Current lifecycle status of the Task.",
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "clarification_required",
        "accepted",
        "in_progress",
        "validation_required",
        "approval_required",
        "blocked",
        "completed",
        "failed",
        "cancelled",
        "superseded",
        "archived"
      ]
    },

    "task_type": {
      "title": "Task Type",
      "description": "Primary operational category of the Task.",
      "type": "string",
      "enum": [
        "research",
        "analysis",
        "content_creation",
        "content_revision",
        "product_documentation",
        "quality_review",
        "planning",
        "repository_management",
        "knowledge_management",
        "website_management",
        "marketing",
        "sales_support",
        "pdms_delivery",
        "automation",
        "general"
      ]
    },

    "business_domain": {
      "title": "Business Domain",
      "description": "Primary BUXA business domain affected by the Task.",
      "type": "string",
      "enum": [
        "brand",
        "products",
        "flooring",
        "pdms",
        "content",
        "xiaohongshu",
        "social_media",
        "website",
        "seo",
        "advertising",
        "sales",
        "market_intelligence",
        "competitor_intelligence",
        "quality_assurance",
        "repository",
        "knowledge_base",
        "runtime",
        "governance",
        "general"
      ]
    },

    "request_channel": {
      "title": "Request Channel",
      "description": "Channel through which the Task entered Scout Runtime.",
      "type": "string",
      "enum": [
        "chat",
        "runtime_api",
        "workflow",
        "scheduled_task",
        "repository_event",
        "email",
        "manual_entry",
        "system",
        "other"
      ]
    },

    "request_source": {
      "title": "Request Source",
      "description": "Information describing where the original Task request came from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "requested_by",
        "received_at"
      ],
      "properties": {
        "channel": {
          "$ref": "#/$defs/request_channel"
        },
        "requested_by": {
          "$ref": "./common.schema.json#/$defs/actor_reference"
        },
        "received_at": {
          "$ref": "./common.schema.json#/$defs/timestamp"
        },
        "source_reference": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/source_reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 240,
          "default": null
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 240,
          "default": null
        }
      }
    },

    "task_scope": {
      "title": "Task Scope",
      "description": "Defines what is included in and excluded from the Task.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "description": "Work explicitly included in the Task.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "default": []
        },
        "excluded": {
          "type": "array",
          "description": "Work explicitly excluded from the Task.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "default": []
        },
        "boundaries": {
          "type": "array",
          "description": "Additional operational or business boundaries.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "task_input": {
      "title": "Task Input",
      "description": "A structured input supplied to the Task.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "input_type",
        "name",
        "required"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^input_[A-Za-z0-9_.:-]+$",
          "minLength": 7,
          "maxLength": 240
        },
        "input_type": {
          "type": "string",
          "enum": [
            "instruction",
            "text",
            "document",
            "image",
            "video",
            "audio",
            "dataset",
            "repository",
            "url",
            "product",
            "memory",
            "workflow_output",
            "tool_result",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4000,
          "default": null
        },
        "required": {
          "type": "boolean"
        },
        "provided": {
          "type": "boolean",
          "default": false
        },
        "source_ref": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/source_reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "description": "Inline value when the input is not represented by a source reference.",
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object",
            "null"
          ],
          "default": null
        },
        "validation_notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provided": {
                "const": true
              }
            },
            "required": [
              "provided"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "source_ref"
                ],
                "properties": {
                  "source_ref": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },

    "deliverable": {
      "title": "Task Deliverable",
      "description": "A specific output that the Task is expected to produce.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable_id",
        "name",
        "description",
        "required"
      ],
      "properties": {
        "deliverable_id": {
          "type": "string",
          "pattern": "^deliverable_[A-Za-z0-9_.:-]+$",
          "minLength": 13,
          "maxLength": 240
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "deliverable_type": {
          "type": "string",
          "enum": [
            "document",
            "content_package",
            "report",
            "analysis",
            "recommendation",
            "plan",
            "image_plan",
            "image_prompt",
            "copy",
            "schema",
            "code",
            "repository_change",
            "quality_report",
            "data",
            "notification",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160,
          "default": null
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "acceptance_notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4000,
          "default": null
        },
        "approval_required": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "constraint_type": {
      "title": "Constraint Type",
      "type": "string",
      "enum": [
        "governance",
        "brand",
        "product",
        "content",
        "quality",
        "legal",
        "financial",
        "technical",
        "time",
        "format",
        "platform",
        "language",
        "source",
        "approval",
        "privacy",
        "security",
        "scope",
        "other"
      ]
    },

    "constraint": {
      "title": "Task Constraint",
      "description": "A requirement or limitation that must be respected during execution.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "constraint_type",
        "description",
        "mandatory"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^constraint_[A-Za-z0-9_.:-]+$",
          "minLength": 12,
          "maxLength": 240
        },
        "constraint_type": {
          "$ref": "#/$defs/constraint_type"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mandatory": {
          "type": "boolean"
        },
        "source_ref": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/source_reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        }
      }
    },

    "success_criterion": {
      "title": "Success Criterion",
      "description": "A measurable or verifiable condition used to determine whether the Task succeeded.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "required",
        "verification_method"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^criterion_[A-Za-z0-9_.:-]+$",
          "minLength": 11,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "required": {
          "type": "boolean"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "target_value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ],
          "default": null
        },
        "status": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "met",
            "partially_met",
            "not_met",
            "not_applicable"
          ],
          "default": "not_evaluated"
        },
        "evidence_refs": {
          "$ref": "./common.schema.json#/$defs/evidence_references"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        }
      }
    },

    "task_dependency": {
      "title": "Task Dependency",
      "description": "An object, action, decision or external condition required by the Task.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "dependency_type",
        "description",
        "required",
        "status"
      ],
      "properties": {
        "dependency_id": {
          "type": "string",
          "pattern": "^dependency_[A-Za-z0-9_.:-]+$",
          "minLength": 12,
          "maxLength": 240
        },
        "dependency_type": {
          "type": "string",
          "enum": [
            "task",
            "runtime_object",
            "knowledge",
            "human_decision",
            "approval",
            "skill",
            "tool",
            "external_event",
            "resource",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "unresolved",
            "pending",
            "available",
            "satisfied",
            "blocked",
            "failed",
            "not_applicable"
          ]
        },
        "related_object_id": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/object_id"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "owner": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/actor_reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "due_at": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },

    "task_authority": {
      "title": "Task Authority",
      "description": "Defines the operational authority granted to Scout for this Task.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autonomy_level",
        "allowed_actions",
        "prohibited_actions"
      ],
      "properties": {
        "autonomy_level": {
          "type": "string",
          "enum": [
            "advisory_only",
            "draft_only",
            "execute_reversible_actions",
            "execute_with_approval_gates",
            "authorised_execution"
          ]
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true,
          "default": []
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true,
          "default": []
        },
        "publishing_allowed": {
          "type": "boolean",
          "default": false
        },
        "external_communication_allowed": {
          "type": "boolean",
          "default": false
        },
        "repository_write_allowed": {
          "type": "boolean",
          "default": false
        },
        "financial_commitment_allowed": {
          "type": "boolean",
          "default": false
        },
        "legal_commitment_allowed": {
          "type": "boolean",
          "default": false
        },
        "deletion_allowed": {
          "type": "boolean",
          "default": false
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4000,
          "default": null
        }
      }
    },

    "clarification_question": {
      "title": "Clarification Question",
      "description": "A question that must or may be answered before Task execution proceeds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question",
        "required"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^question_[A-Za-z0-9_.:-]+$",
          "minLength": 10,
          "maxLength": 240
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "resolved_by_assumption",
            "withdrawn"
          ],
          "default": "open"
        },
        "answer": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object",
            "null"
          ],
          "default": null
        },
        "answered_by": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/actor_reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "answered_at": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "answered"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "answer",
              "answered_by",
              "answered_at"
            ],
            "properties": {
              "answer": {
                "not": {
                  "type": "null"
                }
              },
              "answered_by": {
                "not": {
                  "type": "null"
                }
              },
              "answered_at": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },

    "clarification": {
      "title": "Task Clarification State",
      "description": "Records whether clarification is needed before execution.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "questions"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clarification_question"
          },
          "default": []
        },
        "assumptions_allowed": {
          "type": "boolean",
          "default": true
        },
        "blocking": {
          "type": "boolean",
          "default": false
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "blocking": {
                "const": true
              }
            },
            "required": [
              "blocking"
            ]
          },
          "then": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },

    "execution_policy": {
      "title": "Execution Policy",
      "description": "Controls how Scout Runtime may execute the Task.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "retry_policy",
        "failure_policy"
      ],
      "properties": {
        "execution_mode": {
          "type": "string",
          "enum": [
            "synchronous",
            "asynchronous",
            "scheduled",
            "condition_based",
            "manual"
          ]
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1
        },
        "retry_policy": {
          "type": "string",
          "enum": [
            "no_retry",
            "automatic_retry",
            "manual_retry",
            "retry_with_revision"
          ]
        },
        "failure_policy": {
          "type": "string",
          "enum": [
            "stop",
            "continue_with_limitations",
            "return_to_previous_stage",
            "request_human_review",
            "create_alternative_plan"
          ]
        },
        "allow_partial_completion": {
          "type": "boolean",
          "default": false
        },
        "allow_assumptions": {
          "type": "boolean",
          "default": true
        },
        "require_evidence": {
          "type": "boolean",
          "default": true
        },
        "require_quality_review": {
          "type": "boolean",
          "default": true
        },
        "record_learning": {
          "type": "boolean",
          "default": true
        },
        "timeout_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        }
      }
    },

    "schedule": {
      "title": "Task Schedule",
      "description": "Optional scheduling and deadline information.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not_before": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "due_at": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100,
          "examples": [
            "Asia/Shanghai",
            "Australia/Sydney"
          ],
          "default": null
        },
        "recurrence": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000,
          "default": null
        },
        "urgency_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        }
      }
    }
  },

  "required": [
    "id",
    "schema_name",
    "schema_version",
    "execution_id",
    "created_at",
    "created_by",
    "status",
    "title",
    "task_type",
    "business_domains",
    "priority",
    "request_source",
    "original_request",
    "objective",
    "scope",
    "inputs",
    "deliverables",
    "constraints",
    "success_criteria",
    "authority",
    "risk_assessment",
    "approval",
    "clarification",
    "execution_policy"
  ],

  "properties": {
    "id": {
      "title": "Task Identifier",
      "description": "Unique and immutable identifier of the Task.",
      "type": "string",
      "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },

    "schema_name": {
      "title": "Schema Name",
      "type": "string",
      "const": "task"
    },

    "schema_version": {
      "$ref": "./common.schema.json#/$defs/schema_version"
    },

    "execution_id": {
      "$ref": "./common.schema.json#/$defs/execution_id"
    },

    "workflow_id": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/workflow_id"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },

    "parent_task_id": {
