{
  "capability_schema_version": "1.0.0",
  "capability_id": "scout.capability.retrieval.authoritative_search",
  "capability_version": "1.0.0",
  "name": "Authoritative Search",
  "description": "Retrieve, rank, and package authoritative knowledge required by an approved Task.",
  "engine_type": "retrieval",
  "input_object_types": ["task", "engine_context"],
  "output_object_types": ["knowledge_package"],
  "required_context": {"engine_context_required": true, "required_sections": ["task", "knowledge", "governance"]},
  "valid_current_states": ["retrieval_pending", "retrieval_running", "retrieval_waiting", "knowledge_incomplete"],
  "entry_states": ["retrieval_pending"],
  "proposed_next_states": ["retrieval_running", "retrieval_waiting", "knowledge_ready", "knowledge_incomplete", "retrieval_failed"],
  "dynamic_target_mechanisms": [],
  "decision_types": {"produces": ["scout.decision.selection"], "consumes": [], "required_before_action": [], "required_before_transition": []},
  "quality_requirements": ["Use authoritative sources.", "Preserve provenance.", "Report knowledge gaps."],
  "approval_requirements": {"mode": "conditional", "decision_types": ["scout.decision.approval"]},
  "policy_requirements": {"mode": "conditional", "decision_types": ["scout.decision.policy"]},
  "tool_requirements": [],
  "permissions": ["read_internal", "read_restricted"],
  "side_effect_level": "none",
  "idempotency": {"required": false, "strategy": null},
  "retry_profile": {"supported": true, "maximum_attempts": 2, "requires_retry_decision": true},
  "timeout_profile": {"maximum_seconds": 300, "on_timeout": "return_timeout_engine_result"},
  "dependencies": [],
  "deprecation": null,
  "metadata": {"owner": "Scout Runtime Engine Layer Governance", "immutable": true, "documentation": "README.md"}
}
