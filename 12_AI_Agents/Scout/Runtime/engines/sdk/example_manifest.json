  "supported_states": {"valid_current_states": ["retrieval_pending", "retrieval_running", "retrieval_waiting", "knowledge_incomplete"], "entry_states": ["retrieval_pending"], "proposed_next_states": ["retrieval_running", "retrieval_waiting", "knowledge_ready", "knowledge_incomplete", "retrieval_failed"], "dynamic_target_mechanisms": []},
  "quality_requirements": ["Validate provenance, source authority, relevance, freshness, and completeness."],
